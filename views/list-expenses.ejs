<!DOCTYPE html>
<html>
  <head>
    <title>Expense Tracker</title>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.14.1/themes/smoothness/jquery-ui.css">
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <div class="small-container">
      <div class="row">
        <div class="col-12 content">
          <h1>Expense Tracker</h1>
          <h3>List of Expenses</h3>
          <p><a href="/">Back</a></p>
          <table class="table table-striped">
            <thead>
              <tr>
                <th>Category</th>
                <th>Amount</th>
                <th>Class</th>
                <th>Unit</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% expenses.forEach(function(expense) { %>
                <tr data-expense-id="<%= expense.id %>">
                  <td><%= expense.category_name %></td>
                  <td><%= Number(expense.amount).toFixed(2) %></td>
                  <td><%= expense.class || '' %></td>
                  <td><%= expense.unit || '' %></td>
                  <td><%= expense.created_at %></td>
                  <td>
                    <button
                      type="button"
                      class="btn btn-sm btn-primary edit-expense-btn"
                      data-id="<%= expense.id %>"
                      data-amount="<%= expense.amount %>"
                      data-category-id="<%= expense.category_id %>"
                      data-category-name="<%= expense.category_name %>"
                      data-class="<%= expense.class || '' %>"
                      data-unit="<%= expense.unit || '' %>"
                    >
                      Edit
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm btn-danger delete-expense-btn"
                      data-id="<%= expense.id %>"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="modal fade" id="editExpenseModal" tabindex="-1" aria-labelledby="editExpenseModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="editExpenseModalLabel">Edit Expense</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form id="editExpenseForm">
              <input type="hidden" id="editExpenseId" name="id">

              <div class="mb-3">
                <label for="editAmount" class="form-label">Amount</label>
                <input type="number" step="0.01" min="0" class="form-control" id="editAmount" name="amount" required>
              </div>

              <div class="mb-3">
                <label for="editCategoryName" class="form-label">Category Name</label>
                <input type="text" class="form-control" id="editCategoryName" name="category_name" required>
              </div>

              <div class="mb-3">
                <label for="editClass" class="form-label">Class</label>
                <input type="text" class="form-control" id="editClass" name="class" required>
              </div>

              <div class="mb-3">
                <label for="editUnit" class="form-label">Unit</label>
                <input type="text" class="form-control" id="editUnit" name="unit" required>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" form="editExpenseForm" class="btn btn-primary">Save changes</button>
          </div>
        </div>
      </div>
    </div>
    
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.14.1/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="/javascripts/expense-mappings.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const editExpenseModalElement = document.getElementById("editExpenseModal");
        const editExpenseModal = new bootstrap.Modal(editExpenseModalElement);

        const editExpenseForm = document.getElementById("editExpenseForm");
        const editExpenseIdInput = document.getElementById("editExpenseId");
        const editAmountInput = document.getElementById("editAmount");
        const editCategoryNameInput = document.getElementById("editCategoryName");
        const editClassInput = document.getElementById("editClass");
        const editUnitInput = document.getElementById("editUnit");
        let categories = [];
        let classes = [];
        let units = [];

        function unique(values) {
          return [...new Set(values)].sort((a, b) => a.localeCompare(b));
        }

        function matchingMappings(excludedField) {
          const selected = {
            category: editCategoryNameInput.value.trim(),
            class: editClassInput.value.trim(),
            unit: editUnitInput.value.trim()
          };

          return window.expenseMappings.filter(mapping =>
            Object.keys(selected).every(field =>
              field === excludedField || !selected[field] ||
              mapping[field].toLowerCase() === selected[field].toLowerCase()
            )
          );
        }

        function optionsFor(field, fallback) {
          const mapped = unique(matchingMappings(field).map(mapping => mapping[field]));
          return mapped.length ? mapped : fallback;
        }

        function fillUniqueMatches() {
          const category = editCategoryNameInput.value.trim().toLowerCase();
          const expenseClass = editClassInput.value.trim().toLowerCase();
          let matches = window.expenseMappings.filter(mapping => mapping.category.toLowerCase() === category);

          if (!matches.length && expenseClass) {
            matches = window.expenseMappings.filter(mapping => mapping.class.toLowerCase() === expenseClass);
          }

          if (matches.length) {
            const matchingClasses = unique(matches.map(mapping => mapping.class));
            const matchingUnits = unique(matches.map(mapping => mapping.unit));
            if (matchingClasses.length === 1) editClassInput.value = matchingClasses[0];
            if (matchingUnits.length === 1) editUnitInput.value = matchingUnits[0];
          }
        }

        function configureAutocomplete(selector, field, values) {
          $(selector).autocomplete({
            minLength: 0,
            source: function(request, response) {
              response($.ui.autocomplete.filter(optionsFor(field, values), request.term));
            },
            select: function(event, ui) {
              $(selector).val(ui.item.value);
              setTimeout(fillUniqueMatches, 0);
              return false;
            }
          }).on("focus", function() {
            $(this).autocomplete("search", "");
          }).on("change", fillUniqueMatches);
        }

        $.getJSON("/get-categories", function(data) {
          if (data.status === "NOK") {
            alert("Failed to load categories.");
            return;
          }

          categories = data.data.map(row => row.name).sort((a, b) => a.localeCompare(b));
          configureAutocomplete("#editCategoryName", "category", categories);
        });

        $.getJSON("/get-budget-options", function(data) {
          if (data.status === "NOK") {
            alert("Failed to load classes and units.");
            return;
          }

          classes = data.data.classes.map(row => row.class).sort((a, b) => a.localeCompare(b));
          units = data.data.units.map(row => row.unit).sort((a, b) => a.localeCompare(b));
          configureAutocomplete("#editClass", "class", classes);
          configureAutocomplete("#editUnit", "unit", units);
        });

        document.querySelectorAll(".edit-expense-btn").forEach(function (button) {
          button.addEventListener("click", function () {
            editExpenseIdInput.value = button.dataset.id || "";
            editAmountInput.value = button.dataset.amount || "";
            editCategoryNameInput.value = button.dataset.categoryName || "";
            editClassInput.value = button.dataset.class || "";
            editUnitInput.value = button.dataset.unit || "";

            editExpenseModal.show();
          });
        });

        editExpenseForm.addEventListener("submit", async function (event) {
          event.preventDefault();

          const classExists = classes.some(value => value.toLowerCase() === editClassInput.value.toLowerCase());
          const unitExists = units.some(value => value.toLowerCase() === editUnitInput.value.toLowerCase());
          if (!classExists || !unitExists) {
            alert("The selected class or unit does not exist in the budget.");
            return;
          }

          const payload = new URLSearchParams({
            id: editExpenseIdInput.value,
            amount: editAmountInput.value,
            category_name: editCategoryNameInput.value,
            class: editClassInput.value,
            unit: editUnitInput.value,
          });

          try {
            const response = await fetch("/edit-expense", {
              method: "POST",
              headers: {
                "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
              },
              body: payload.toString(),
            });

            if (!response.ok) {
              throw new Error("Failed to edit expense");
            }

            const result = await response.json();
            if (result.status !== "OK") {
              alert(result.error || "Could not edit expense. Please try again.");
              return;
            }

            editExpenseModal.hide();
            window.location.reload();
          } catch (error) {
            alert("Could not edit expense. Please try again.");
          }
        });

        document.querySelectorAll(".delete-expense-btn").forEach(function (button) {
          button.addEventListener("click", async function () {
            const expenseId = button.dataset.id;

            if (!expenseId) {
              return;
            }

            const confirmed = window.confirm("Are you sure you want to delete this expense?");
            if (!confirmed) {
              return;
            }

            const payload = new URLSearchParams({ id: expenseId });

            try {
              const response = await fetch("/delete-expense", {
                method: "POST",
                headers: {
                  "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
                },
                body: payload.toString(),
              });

              if (!response.ok) {
                throw new Error("Failed to delete expense");
              }

              window.location.reload();
            } catch (error) {
              alert("Could not delete expense. Please try again.");
            }
          });
        });
      });
    </script>
  </body>
</html>
